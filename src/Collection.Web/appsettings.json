{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Snapshot": {
    "Enabled": true,
    "RetentionDays": 14,
    "FlushSeconds": 5
  },
  "Updates": {
    "ShowReleaseNotes": true
  },
  "AllowedHosts": "*"
}
