@page "/changepassword"

@layout EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IUserRepository UserRepository
@inject ToastService ToastService
@inject ChangePasswordMoveableObject Obj
@inject ILogService<ChangePassword> Log

<PageTitle>Change password · WAFIF Collection Management</PageTitle>

<Spinner IsVisible="@__saving" Message="Changing password" />
<ToastContainer />

@* ---------- Change password form ---------- *@
<Hero Title="" Subtitle="" BrandName="WAFIF Collection Management">
    <AuthCard Title="Choose a new password"
              Subtitle="@($"Account: {Obj.fstrUsername}. Please change your temporary password to continue.")">
        <EditForm Model="__model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="new-password">New password</label>
                <PasswordInput id="new-password" class="input" AutoComplete="new-password" @bind-Value="__model.fstrPassword" />
                <ValidationMessage For="@(() => __model.fstrPassword)" />
            </div>

            <div class="auth-field">
                <label for="confirm-password">Confirm new password</label>
                <PasswordInput id="confirm-password" class="input" AutoComplete="new-password" @bind-Value="__model.fstrConfirmPassword" />
                <ValidationMessage For="@(() => __model.fstrConfirmPassword)" />
            </div>

            <button class="btn btn-primary auth-submit" type="submit" disabled="@__saving">Save new password</button>

            <a class="auth-link" href="/login">&larr; Back to sign in</a>
        </EditForm>
    </AuthCard>
</Hero>

@code {

    #region Private Fields

    private readonly ChangePasswordDataTransferObject __model = new();
    private bool __saving;

    #endregion

    #region Lifecycle

    /// <summary>
    /// The page can only be reached from the sign-in step that verified the temporary password.
    /// Anyone arriving directly (no pending user) is sent back to sign in.
    /// </summary>
    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Obj.fstrUsername))
            Navigation.NavigateTo("/login", replace: true);
    }

    #endregion

    #region Handle Valid Submit

    private async Task HandleValidSubmit()
    {
        if (__saving || string.IsNullOrWhiteSpace(Obj.fstrUsername)) return;

        __saving = true;
        await GlobalService.DelayAsync();

        try
        {
            var passwordHash = BCrypt.Net.BCrypt.HashPassword(__model.fstrPassword);
            var result = await UserRepository.UpdatePasswordAsync(Obj.fstrUsername!, passwordHash);

            if (result.ToastType != ToastTypeModel.Success)
            {
                ToastService.Show(result.ToastType, result.Message!);
                return;
            }

            // Done – forget the carried username so the page cannot be reused.
            Obj.Clear();

            // BUG FIX: this used to go to "/?msg=password_reset", but the home page ignores
            // the message. The sign-in page shows the "password reset" toast.
            Navigation.NavigateTo("/login?msg=password_reset", replace: true);
        }
        catch (Exception ex)
        {
            await Log.LogError($"Change password failed: {ex.Message}");
            ToastService.ShowError("Unable to change the password right now. Please try again.");
        }
        finally
        {
            __saving = false;
        }
    }

    #endregion
}
