    public class SummaryItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
        public string? Icon { get; set; }
        public string? ColorTheme { get; set; } = "gray";
        public DateTime? Date { get; set; }
        public object? Tag { get; set; }
    }

    /// <summary>One time period (day / month / year, etc.) in the date-range breakdown table.</summary>
    public class DateBucket
    {
        /// <summary>Primary label, e.g. "Jun 2026", "Week 1", "Mon".</summary>
        public string Label { get; set; } = "";
        /// <summary>Optional secondary text shown beside the label.</summary>
        public string? SubLabel { get; set; }
        /// <summary>Period total. If left 0 and Lines are supplied, it's summed from the lines.</summary>
        public decimal Value { get; set; }
        /// <summary>Optional per-collection-type breakdown shown as indented rows under the period.</summary>
        public List<DateBreakdownLine>? Lines { get; set; }
        /// <summary>Optional arbitrary payload.</summary>
        public object? Tag { get; set; }
    }

    /// <summary>A single collection type's amount within a <see cref="DateBucket"/>.</summary>
    public class DateBreakdownLine
    {
        /// <summary>The collection type (or other category) label.</summary>
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
        public string? ColorTheme { get; set; } = "gray";
    }
}
