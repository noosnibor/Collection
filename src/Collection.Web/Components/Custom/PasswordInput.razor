@* PasswordInput – a form input with a "show / hide password" button.
   Works like InputText: use @bind-Value and a ValidationMessage inside an EditForm.
   (Replaces ~25 lines of duplicated markup, including a huge inline SVG, on each page.) *@
@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string?>

<div class="pw-wrap">
    <input @attributes="AdditionalAttributes"
           type="@(__visible ? "text" : "password")"
           class="@CssClass"
           value="@CurrentValueAsString"
           autocomplete="@AutoComplete"
           @oninput="HandleInput" />

    <button type="button"
            class="pw-eye"
            tabindex="-1"
            aria-label="@(__visible ? "Hide password" : "Show password")"
            title="@(__visible ? "Hide password" : "Show password")"
            @onclick="Toggle">
        @((MarkupString)Icons.Get(__visible ? "eye-off" : "eye", "currentColor", 18))
    </button>
</div>

@code {
    #region Parameters

    /// <summary>The browser autocomplete hint ("current-password" or "new-password").</summary>
    [Parameter] public string AutoComplete { get; set; } = "current-password";

    #endregion

    #region Private Fields

    private bool __visible;

    #endregion

    #region InputBase Implementation

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value,
                                                    out string? result,
                                                    [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    #endregion

    #region Event Handlers

    private void HandleInput(ChangeEventArgs e) => CurrentValueAsString = e.Value?.ToString();

    private void Toggle() => __visible = !__visible;

    #endregion
}
